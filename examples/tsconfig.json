{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@vxr/core": ["../packages/core/src/index.ts"],
      "@vxr/ar": ["../packages/ar/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "basic-viewer/**/*",
    "architecture-viewer/**/*",
    "interaction-lab/**/*",
    "scenario-builder/**/*",
    "level-builder/**/*",
    "ar-viewer/**/*"
  ]
}
