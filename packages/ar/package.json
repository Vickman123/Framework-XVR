    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vxr/core": "*",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2"
  }
}
