{
  "name": "@vxr/ar",
  "version": "0.1.0",
  "description": "VXR AR: Lightweight cross-browser Web Augmented Reality and vision tracking layer for Three.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
