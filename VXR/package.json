{
  "name": "vxr",
  "version": "0.1.0",
  "description": "VXR: High-level interactive WebXR and 3D simulation framework for Three.js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": ">=0.170.0"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "webxr",
    "threejs",
    "three",
    "vr",
    "meta-quest",
    "framework",
    "spatial-computing",
    "3d",
    "typescript"
  ],
  "author": "VXR Framework",
  "license": "MIT"
}
